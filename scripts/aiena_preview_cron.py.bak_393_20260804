#!/usr/bin/env python3
"""
aiena_preview_cron.py — Automatic draft → preview pipeline for aiena.it

Runs nightly at 06:00 CEST. Finds all investigations with status 'draft_ready'
in pipeline.json, converts their DRAFT_*.md files to HTML previews,
uploads to /preview/ via FTP, updates pipeline.json status to 'preview',
rebuilds admin data.json, and notifies AIena + Mirko.

Cron entry (Europe/Rome):
    0 4 * * * /home/pinky/.pinkybot/.venv/bin/python3 /home/pinky/.pinkybot/scripts/aiena_preview_cron.py >> /home/pinky/.pinkybot/data/logs/preview_cron.log 2>&1

Author: Satoshi (PinkyBot)
"""

import json
import os
import re
import subprocess
import sys
import tempfile
import textwrap
from datetime import datetime, timezone
from pathlib import Path as _Path

# Editorial review (imported lazily to avoid startup cost when not needed)
def _run_editorial_review(slug: str, draft_path) -> dict:
    try:
        from aiena_editorial_review import run_review
        return run_review(slug, draft_path)
    except Exception as e:
        log(f"  [review] WARN: Could not run editorial review: {e} — proceeding without")
        return {"overall_pass": True, "manual_review_needed": False, "rounds": 0, "summary": f"review skipped: {e}"}
from pathlib import Path
from typing import Optional

# ── Secrets ──────────────────────────────────────────────────────────────────
def _load_secrets() -> dict:
    """Load sensitive credentials from .aiena_secrets file (chmod 600).
    Falls back to environment variables for cron/daemon contexts."""
    secrets: dict = {}
    secrets_file = Path("/home/pinky/.pinkybot/scripts/.aiena_secrets")
    if secrets_file.exists():
        for line in secrets_file.read_text().splitlines():
            line = line.strip()
            if line and "=" in line and not line.startswith("#"):
                k, _, v = line.partition("=")
                secrets[k.strip()] = v.strip()
    for key in ("SB_SERVICE_KEY", "FTP_PASS"):
        if os.environ.get(key):
            secrets[key] = os.environ[key]
    return secrets


# ── Config ───────────────────────────────────────────────────────────────────
PIPELINE_PATH    = Path("/var/www/aiena.it/data/pipeline.json")
PREVIEW_LOCAL    = Path("/var/www/aiena.it/preview")
DRAFTS_DIR       = Path("/home/pinky/.pinkybot/data/agents/aiena")
LOG_DIR          = Path("/home/pinky/.pinkybot/data/logs")

FTP_HOST = "ftp.aiena.it"
FTP_USER = "aiena.it"
FTP_PASS = _load_secrets().get("FTP_PASS", "")

AIENA_OG_IMAGE   = "https://www.aiena.it/assets/aiena-og.jpg"
AIENA_STYLES_VER = "20260505"

TELEGRAM_BOT_TOKEN = _load_secrets().get("TELEGRAM_BOT_TOKEN", "") or os.getenv("TELEGRAM_BOT_TOKEN", "")
TELEGRAM_MIRKO_ID  = "32405655"

PINKYBOT_API = "http://127.0.0.1:8888"

# Italian months
MONTHS_IT = ["gennaio","febbraio","marzo","aprile","maggio","giugno",
             "luglio","agosto","settembre","ottobre","novembre","dicembre"]


# ── Logging ───────────────────────────────────────────────────────────────────
def log(msg: str):
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    print(f"[{ts}] {msg}", flush=True)


def date_it(d: datetime) -> str:
    return f"{d.day} {MONTHS_IT[d.month-1]} {d.year}"


# ── Pipeline JSON ────────────────────────────────────────────────────────────
def load_pipeline() -> dict:
    try:
        return json.loads(PIPELINE_PATH.read_text("utf-8"))
    except FileNotFoundError:
        log("ERROR: pipeline.json not found")
        return {"investigations": [], "leads": [], "published": []}
    except json.JSONDecodeError as e:
        log(f"ERROR: pipeline.json is corrupted: {e}")
        return {"investigations": [], "leads": [], "published": []}


def save_pipeline(data: dict):
    data["updated_at"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    tmp_fd, tmp_path = tempfile.mkstemp(dir=PIPELINE_PATH.parent, suffix=".tmp")
    try:
        with os.fdopen(tmp_fd, "w", encoding="utf-8") as fh:
            fh.write(json.dumps(data, ensure_ascii=False, indent=4))
        os.replace(tmp_path, PIPELINE_PATH)
    finally:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)


def set_status(pipeline: dict, slug: str, new_status: str):
    for inv in pipeline.get("investigations", []):
        if inv.get("slug") == slug:
            inv["status"] = new_status
            log(f"  pipeline.json: {slug} → {new_status}")
            return True
    return False


# ── DRAFT file finder ────────────────────────────────────────────────────────
def find_draft(slug: str) -> Optional[Path]:
    """
    Find DRAFT_*.md file matching given slug in AIena agent directory.
    Tries exact match first, then fuzzy (slug tokens in filename).
    """
    # Exact: DRAFT_<slug>.md (with hyphens or underscores)
    candidates = [
        DRAFTS_DIR / f"DRAFT_{slug}.md",
        DRAFTS_DIR / f"DRAFT_{slug.replace('-','_')}.md",
        DRAFTS_DIR / f"draft_{slug}.md",
        DRAFTS_DIR / f"draft_{slug.replace('-','_')}.md",
    ]
    for p in candidates:
        if p.exists():
            return p

    # Fuzzy: any DRAFT_*.md whose name contains the first 3 slug tokens
    slug_tokens = slug.split("-")[:3]
    for f in DRAFTS_DIR.glob("DRAFT_*.md"):
        fname_lower = f.name.lower()
        if all(tok in fname_lower for tok in slug_tokens):
            return f

    return None


# ── Markdown → HTML conversion ───────────────────────────────────────────────
def parse_frontmatter(text: str) -> tuple[dict, str]:
    """
    Extract YAML-like frontmatter (--- ... ---) from markdown text.
    Returns (meta_dict, body_text).
    """
    meta = {}
    body = text

    if text.startswith("---"):
        parts = text.split("---", 2)
        if len(parts) >= 3:
            fm_text = parts[1].strip()
            body = parts[2].strip()
            for line in fm_text.splitlines():
                if ":" in line:
                    k, _, v = line.partition(":")
                    meta[k.strip().lower()] = v.strip().strip('"').strip("'")

    return meta, body


def md_to_html(md_text: str) -> str:
    """
    Convert markdown text to HTML using the markdown library.
    Falls back to basic regex conversion if library unavailable.
    """
    try:
        import markdown as md_lib
        return md_lib.markdown(
            md_text,
            extensions=["extra", "nl2br", "sane_lists"],
        )
    except ImportError:
        pass

    # Minimal fallback converter
    html = md_text

    # Code blocks
    html = re.sub(r'```[\w]*\n(.*?)```', lambda m: f'<pre><code>{m.group(1)}</code></pre>', html, flags=re.DOTALL)

    # Headers
    for level in range(6, 0, -1):
        html = re.sub(rf'^{"#"*level} (.+)$', rf'<h{level}>\1</h{level}>', html, flags=re.MULTILINE)

    # Bold + italic
    html = re.sub(r'\*\*\*(.+?)\*\*\*', r'<strong><em>\1</em></strong>', html)
    html = re.sub(r'\*\*(.+?)\*\*', r'<strong>\1</strong>', html)
    html = re.sub(r'\*(.+?)\*', r'<em>\1</em>', html)

    # Links
    html = re.sub(r'\[([^\]]+)\]\(([^)]+)\)', r'<a href="\2">\1</a>', html)

    # Horizontal rules
    html = re.sub(r'^---$', '<hr>', html, flags=re.MULTILINE)

    # Paragraphs (blank line separators)
    blocks = re.split(r'\n{2,}', html.strip())
    result = []
    for block in blocks:
        block = block.strip()
        if not block:
            continue
        if block.startswith('<'):
            result.append(block)
        else:
            result.append(f'<p>{block}</p>')
    html = '\n'.join(result)

    return html


# ── Extract title/description from markdown body ─────────────────────────────
def extract_h1(html_body: str) -> str:
    m = re.search(r'<h1[^>]*>(.*?)</h1>', html_body, re.IGNORECASE | re.DOTALL)
    return re.sub(r'<[^>]+>', '', m.group(1)).strip() if m else ""


def extract_first_p(html_body: str) -> str:
    m = re.search(r'<p[^>]*>(.*?)</p>', html_body, re.IGNORECASE | re.DOTALL)
    if not m:
        return ""
    text = re.sub(r'<[^>]+>', '', m.group(1)).strip()
    return text[:200] + ("…" if len(text) > 200 else "")


def _inject_open_question(body_html: str) -> str:
    """
    Ensures article body contains an .open-question div (required by auto_publish validation).
    If already present, returns unchanged.
    Tries to detect a 'domanda' H2/H3 section and wrap it.
    Falls back to appending a placeholder at the end.
    """
    if "open-question" in body_html:
        return body_html

    # Detect headings that suggest an open-question section
    pattern = re.compile(
        r'(<h[23][^>]*>[^<]*domand[^<]*</h[23]>)(.*?)(?=<h[1-6]|$)',
        re.IGNORECASE | re.DOTALL,
    )
    m = pattern.search(body_html)
    if m:
        heading = m.group(1)
        content = m.group(2).strip()
        wrapped = (
            f'\n<div class="open-question">'
            f'\n  <div class="open-question-label">→ La domanda senza risposta</div>'
            f'\n  {content}'
            f'\n</div>\n'
        )
        return body_html[: m.start(1)] + heading + wrapped + body_html[m.end() :]

    # Fallback: append placeholder (AIena deve riempirlo prima della pubblicazione)
    placeholder = (
        '\n<div class="open-question">'
        '\n  <div class="open-question-label">→ La domanda senza risposta</div>'
        '\n  <p>[Inserire la domanda aperta prima della pubblicazione]</p>'
        '\n</div>\n'
    )
    return body_html + placeholder


# ── HTML preview builder ─────────────────────────────────────────────────────
PREVIEW_BANNER = textwrap.dedent("""\
    <div class="preview-banner">
      ⚠ BOZZA IN ATTESA DI APPROVAZIONE — Non pubblicata
    </div>""")

PREVIEW_STYLES = textwrap.dedent("""\
    <style>
      .preview-banner {
        background: rgba(255,165,0,0.12);
        border-bottom: 2px solid rgba(255,165,0,0.4);
        padding: 0.6rem 1.25rem;
        text-align: center;
        font-family: var(--font-mono, monospace);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        color: rgba(255,165,0,0.9);
        text-transform: uppercase;
      }
      .fonti-list { padding-left: 1.25rem; }
      .fonti-list li { margin-bottom: 0.5rem; font-size: 0.88rem; color: rgba(255,255,255,0.7); line-height: 1.6; }
    </style>""")


def build_preview_html(slug: str, meta: dict, article_body_html: str) -> str:
    """Build a full preview HTML page from parsed draft content.

    Includes all elements required by validate_preview_before_publish():
    - NewsArticle JSON-LD schema
    - .ai-notice AI disclaimer
    - .open-question box (detected from body or placeholder)
    - rel="canonical"
    """
    now = datetime.now()
    date_iso = meta.get("data_pubblicazione", meta.get("date", now.strftime("%Y-%m-%d")))
    date_display = date_it(now)

    # Title from frontmatter > first H1 > slug
    title = (
        meta.get("titolo", meta.get("title", ""))
        or extract_h1(article_body_html)
        or slug.replace("-", " ").title()
    )
    description = (
        meta.get("descrizione", meta.get("description", ""))
        or extract_first_p(article_body_html)
        or title
    )
    category = meta.get("categoria", meta.get("category", "Inchiesta"))

    # Ensure .open-question is present in body (required by validation)
    article_body_html = _inject_open_question(article_body_html)

    # Build JSON-LD NewsArticle schema (required by validation)
    # Use json.dumps for values to properly escape special chars
    jsonld_obj = {
        "@context": "https://schema.org",
        "@type": "NewsArticle",
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": f"https://www.aiena.it/preview/{slug}.html",
        },
        "headline": title[:110],
        "description": description[:200],
        "image": AIENA_OG_IMAGE,
        "datePublished": date_iso,
        "dateModified": date_iso,
        "author": {
            "@type": "Person",
            "name": "AIena",
            "url": "https://www.aiena.it/autore/aiena.html",
        },
        "publisher": {
            "@type": "NewsMediaOrganization",
            "name": "AIena",
            "url": "https://www.aiena.it",
            "logo": {
                "@type": "ImageObject",
                "url": "https://www.aiena.it/assets/logo-horizontal.svg",
            },
        },
        "url": f"https://www.aiena.it/preview/{slug}.html",
        "inLanguage": "it",
        "isAccessibleForFree": True,
    }
    jsonld_block = (
        '  <script type="application/ld+json">\n'
        + json.dumps(jsonld_obj, ensure_ascii=False, indent=2)
        + "\n  </script>"
    )

    # AI disclaimer (required by validation: .ai-notice)
    ai_notice = (
        '  <!-- AI DISCLAIMER -->\n'
        '  <div class="ai-notice">\n'
        '    <span class="ai-notice-icon">AI</span>\n'
        '    <p>Questo contenuto è stato generato da un sistema di intelligenza artificiale (AIena). '
        'Come ogni AI, può commettere errori o produrre imprecisioni. Le fonti sono indicate inline '
        'e verificabili autonomamente. Ogni articolo è soggetto a revisione umana prima della '
        'pubblicazione, ma ti invitiamo a verificare sempre le informazioni prima di condividerle. '
        '<a href="/metodologia.html">Come lavoriamo →</a></p>\n'
        '  </div>'
    )

    html = f"""<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="/fonts.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | AIena</title>
  <meta name="description" content="{description[:300]}">
  <meta property="og:title" content="{title[:100]}">
  <meta property="og:description" content="{description[:200]}">
  <meta property="og:type" content="article">
  <meta property="og:image" content="{AIENA_OG_IMAGE}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:image" content="{AIENA_OG_IMAGE}">
  <meta property="og:url" content="https://www.aiena.it/preview/{slug}.html">
  <meta property="og:site_name" content="AIena">
  <meta property="article:published_time" content="{date_iso}">
  <meta property="article:author" content="AIena">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{title[:100]}">
  <meta name="twitter:description" content="{description[:200]}">
  <meta name="robots" content="noindex, nofollow">
  <link rel="canonical" href="https://www.aiena.it/preview/{slug}.html">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="stylesheet" href="../styles.css?v={AIENA_STYLES_VER}">
  {PREVIEW_STYLES}
{jsonld_block}
</head>
<body>
{PREVIEW_BANNER}
<main class="article-page" style="max-width:860px;margin:0 auto;padding:2rem 1.25rem">
  <header class="article-header" style="margin-bottom:2rem">
    <div class="article-meta" style="margin-bottom:1rem">
      <span class="category-badge">{category}</span>
      <time datetime="{date_iso}" style="font-size:0.8rem;color:rgba(255,255,255,0.4);margin-left:1rem">{date_display}</time>
    </div>
    <h1 class="article-title" style="font-size:2rem;line-height:1.25;margin-bottom:1rem">{title}</h1>
    <p class="article-subtitle" style="font-size:1.05rem;color:rgba(255,255,255,0.6);line-height:1.6">{description}</p>
  </header>
  <article class="article-body">
{ai_notice}
{article_body_html}
  </article>
  <footer style="margin-top:3rem;padding-top:1.5rem;border-top:1px solid rgba(255,255,255,0.08);font-size:0.75rem;color:rgba(255,255,255,0.3)">
    <p>⚠ Articolo in bozza — Questa preview non è pubblica. Generata automaticamente il {date_display}.</p>
  </footer>
</main>
</body>
</html>"""
    return html


# ── FTP upload ───────────────────────────────────────────────────────────────
def ftp_upload(local_path: Path, remote_path: str, dry_run: bool = False) -> bool:
    """Upload a file via curl FTP."""
    if dry_run:
        log(f"  [DRY-RUN] Would FTP upload {local_path} → {remote_path}")
        return True

    cmd = [
        "curl", "--silent", "--show-error",
        "-T", str(local_path),
        f"ftp://{FTP_HOST}/{remote_path}",
        "--user", f"{FTP_USER}:{FTP_PASS}",
        "--ftp-create-dirs",
    ]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
        if result.returncode == 0:
            log(f"  FTP OK → {remote_path}")
            return True
        else:
            log(f"  FTP ERROR: {result.stderr.strip()}")
            return False
    except subprocess.TimeoutExpired:
        log(f"  FTP TIMEOUT: {remote_path}")
        return False
    except Exception as e:
        log(f"  FTP EXCEPTION: {e}")
        return False


# ── Rebuild admin data ────────────────────────────────────────────────────────
def rebuild_admin(dry_run: bool = False):
    """Rebuild admin/data.json and deploy via FTP."""
    if dry_run:
        log("  [DRY-RUN] Would rebuild admin data.json")
        return
    script = Path("/home/pinky/.pinkybot/scripts/update_admin_data.py")
    if not script.exists():
        log(f"  WARN: {script} not found — skipping admin rebuild")
        return
    try:
        result = subprocess.run(
            [sys.executable, str(script)],
            capture_output=True, text=True, timeout=120
        )
        if result.returncode == 0:
            log("  Admin data.json rebuilt OK")
        else:
            log(f"  Admin rebuild WARN: {result.stderr.strip()[:200]}")
    except Exception as e:
        log(f"  Admin rebuild EXCEPTION: {e}")


# ── HMAC auth helper ──────────────────────────────────────────────────────────
def _build_auth_headers(method: str, path: str) -> dict:
    """Costruisce HMAC-signed headers per PinkyBot API (richiesti da tutti gli endpoint /agents/)."""
    try:
        import sys as _sys
        _sys.path.insert(0, "/home/pinky/.pinkybot/src")
        from pinky_daemon.auth import build_internal_auth_headers
        secret = (__import__("os").environ.get("PINKY_SESSION_SECRET") or next((l.split("=",1)[1].strip().strip('"\'') for l in __import__("pathlib").Path("/home/pinky/.pinkybot/.env").read_text().splitlines() if l.startswith("PINKY_SESSION_SECRET=")), ""))
        return build_internal_auth_headers(secret, agent_name="satoshi", method=method, path=path)
    except Exception as e:
        log(f"  WARN: auth headers error: {e}")
        return {}


# ── Pre-scan: hallucination / investigative-action patterns ──────────────────
HALLUCINATION_PATTERNS = [
    r"è stata inviata.{0,80}(verifica|PEC|lettera|richiesta|comunicazione)",
    r"è stato inviato.{0,80}(al comune|al protocollo|all'ente)",
    r"abbiamo (inviato|contattato|richiesto|scritto)",
    r"deadline per risposta",
    r"silenzio-inadempimento",
    r"ai sensi dell.art\. 2.{0,30}241/1990",
]


def pre_scan_for_hallucinations(draft_text: str) -> list[str]:
    """
    Fast regex pre-check for patterns that imply undocumented investigative actions
    (letters sent, official requests, deadline references, etc.).
    Returns a list of found pattern descriptions (empty = clean).
    These patterns are symptomatic of hallucinated facts and must ALWAYS block
    the preview — they are NOT auto-correctable.
    """
    found = []
    for pattern in HALLUCINATION_PATTERNS:
        matches = re.findall(pattern, draft_text, re.IGNORECASE)
        if matches:
            found.append(f"Pattern '{pattern}': {matches[:2]}")
    return found


# ── TASK A: Draft validation (internal notes check) ──────────────────────────
def validate_draft_for_internal_notes(slug: str, draft_text: str) -> tuple[bool, str]:
    """
    Validate that draft_text does not contain internal metadata that would leak
    into published HTML. Detects patterns like:
      - Categoria: ...
      - Slug: ...
      - Status: ...
      - Data draft: ...
      - Pub_date (prevista): ...
      - Nota: ...
      - Versione N: ...
      - Da completare: ...
      - Revisione: ...

    Returns (is_valid, error_reason).
    If pattern is found: (False, error message with details)
    If no pattern: (True, "")
    """
    pattern = r'^\*{0,2}(Categoria|Slug|Status|Data\s+draft|Pub_date\s*(?:prevista)?|Nota|Versione\s*\d|Da\s+completare|Revisione)\s*[:\|]'

    matches = re.finditer(pattern, draft_text, flags=re.MULTILINE | re.IGNORECASE)
    match_list = list(matches)

    if match_list:
        first_match = match_list[0]
        line_num = draft_text[:first_match.start()].count('\n') + 1
        error_msg = (
            f"INTERNAL NOTES DETECTED in draft [{slug}]:\n"
            f"  Line {line_num}: {first_match.group(0)}\n"
            f"  Total matches: {len(match_list)}\n"
            f"  These metadata would leak into published HTML."
        )
        return False, error_msg
    return True, ""


def notify_aiena_internal(message: str):
    """Send internal message to AIena via PinkyBot agent messaging."""
    try:
        import urllib.request
        path = "/agents/aiena/message"
        payload = json.dumps({
            "from_agent": "satoshi",
            "message": message,
            "priority": 3,
        }).encode()
        headers = {"Content-Type": "application/json"}
        headers.update(_build_auth_headers("POST", path))
        req = urllib.request.Request(
            f"{PINKYBOT_API}{path}",
            data=payload,
            headers=headers,
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=10):
            pass
    except Exception as e:
        log(f"  WARN: Failed to notify AIena: {e}")


# ── Notify AIena ──────────────────────────────────────────────────────────────
def notify_aiena(slugs: list[str]):
    """Send message to AIena via PinkyBot agent messaging (with HMAC auth)."""
    if not slugs:
        return
    slug_list = "\n".join(f"  - https://www.aiena.it/preview/{s}.html" for s in slugs)
    msg = (
        f"PREVIEW PRONTE: {len(slugs)} articolo/i convertiti da draft_ready a preview.\n"
        f"{slug_list}\n\n"
        "Preview visibili nel pannello admin. Mirko sarà avvisato automaticamente."
    )
    try:
        import urllib.request
        path = "/agents/aiena/message"
        payload = json.dumps({
            "from_agent": "satoshi",
            "message": msg,
            "priority": 2,
        }).encode()
        headers = {"Content-Type": "application/json"}
        headers.update(_build_auth_headers("POST", path))
        req = urllib.request.Request(
            f"{PINKYBOT_API}{path}",
            data=payload,
            headers=headers,
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=10):
            log(f"  AIena notificata: {len(slugs)} preview")
    except Exception as e:
        log(f"  AIena notify WARN: {e}")


# ── Notify Mirko ──────────────────────────────────────────────────────────────
def notify_mirko(slugs: list[str], dry_run: bool = False):
    """Send Telegram message to Mirko via PinkyBot messaging API."""
    if not slugs or dry_run:
        return

    slug_list = "\n".join(
        f"  • https://aiena.it/preview/{s}.html" for s in slugs
    )
    text = (
        f"*AIena: {len(slugs)} nuova/e preview pronta/e*\n\n"
        f"{slug_list}\n\n"
        "Visibili nel pannello admin per approvazione."
    )

    try:
        import urllib.request
        payload = json.dumps({
            "agent_name": "satoshi",
            "chat_id": TELEGRAM_MIRKO_ID,
            "platform": "telegram",
            "content": text,
            "parse_mode": "Markdown",
        }).encode()
        req = urllib.request.Request(
            f"{PINKYBOT_API}/broker/send",
            data=payload,
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=10):
            log(f"  Mirko notificato via Telegram")
    except Exception as e:
        log(f"  Mirko notify WARN: {e}")


# ── Main ─────────────────────────────────────────────────────────────────────
def main():
    import argparse
    parser = argparse.ArgumentParser(description="AIena preview cron: draft_ready → preview")
    parser.add_argument("--dry-run", action="store_true", help="Skip FTP uploads and notifications")
    parser.add_argument("--force-slug", help="Force processing a specific slug (regardless of status)")
    args = parser.parse_args()

    LOG_DIR.mkdir(parents=True, exist_ok=True)
    log("=" * 60)
    log(f"aiena_preview_cron.py START {'[DRY-RUN]' if args.dry_run else ''}")

    pipeline = load_pipeline()
    investigations = pipeline.get("investigations", [])

    # Determine candidates
    if args.force_slug:
        candidates = [inv for inv in investigations if inv.get("slug") == args.force_slug]
        if not candidates:
            log(f"ERROR: slug '{args.force_slug}' not found in pipeline.json")
            sys.exit(1)
    else:
        # Primary: explicit draft_ready status
        explicit = [inv for inv in investigations if inv.get("status") == "draft_ready"]

        # Secondary: scrittura investigations that have a matching DRAFT file
        # and no preview HTML already present — auto-detect when AIena finishes writing
        auto_detect = []
        for inv in investigations:
            if inv.get("status") != "scrittura":
                continue
            slug = inv["slug"]
            # Skip if preview already exists
            if (PREVIEW_LOCAL / f"{slug}.html").exists():
                continue
            # Include only if a DRAFT file exists
            if find_draft(slug) is not None:
                auto_detect.append(inv)

        candidates = explicit + [i for i in auto_detect if i not in explicit]

        if auto_detect:
            log(f"Auto-detected {len(auto_detect)} scrittura investigation(s) with existing DRAFT:")
            for c in auto_detect:
                log(f"  - {c['slug']}")

    log(f"Candidates total: {len(candidates)}")
    for c in candidates:
        log(f"  - {c['slug']} ({c.get('status','?')})")

    if not candidates:
        log("Nothing to do.")
        log("aiena_preview_cron.py END\n")
        return

    PREVIEW_LOCAL.mkdir(parents=True, exist_ok=True)
    processed = []
    failed = []
    ftp_failed = []  # FIX Bug#2: track FTP failures separately from processing failures

    for inv in candidates:
        slug = inv["slug"]
        log(f"\nProcessing: {slug}")

        # 1. Find DRAFT file
        draft_path = find_draft(slug)
        if not draft_path:
            log(f"  ERROR: No DRAFT_*.md found for slug '{slug}' — skipping")
            failed.append(slug)
            continue
        log(f"  Draft found: {draft_path.name}")

        # 1.5a. PRE-SCAN: fast regex check for hallucinated investigative actions
        #        (letters sent, PEC, official requests, deadlines, silenzio-inadempimento).
        #        If found → immediate block, no LLM call, status → draft_error.
        pre_scan_hits = pre_scan_for_hallucinations(draft_path.read_text("utf-8"))
        if pre_scan_hits:
            block_msg = (
                f"BLOCCO PRE-SCAN: trovato pattern 'azioni investigative dichiarate' in [{slug}] "
                f"— richiede verifica manuale.\n"
                f"Pattern trovati:\n" + "\n".join(f"  • {h}" for h in pre_scan_hits)
            )
            log(f"  {block_msg}")
            if not args.dry_run:
                set_status(pipeline, slug, "draft_error")
                save_pipeline(pipeline)
                notify_aiena_internal(block_msg)
            failed.append(slug)
            continue

        # 1.5b. Editorial review — check for accusatory language, missing hedging,
        #        assertive titles. Auto-fixes draft in place if issues found.
        #        Blocks preview if manual review needed after 2 rounds.
        if not args.dry_run:
            review_result = _run_editorial_review(slug, draft_path)
            if review_result.get("manual_review_needed"):
                log(f"  [review] BLOCKED — manual review needed. Preview NOT deployed.")
                log(f"  [review] Summary: {review_result.get('summary','')}")
                # Notify AIena via daemon
                try:
                    import urllib.request
                    payload = json.dumps({
                        "from_agent": "aiena_preview_cron",
                        "message": (
                            f"⚠️ REVIEW BLOCCATA per [{slug}]\n"
                            f"Il draft non ha superato il controllo editoriale dopo "
                            f"{review_result.get('rounds',0)} round(s).\n"
                            f"Motivo: {review_result.get('summary','')}\n"
                            f"Revi manualmente: DRAFT_{slug}.md"
                        )
                    }).encode()
                    req = urllib.request.Request(
                        "http://localhost:8888/agents/aiena/message",
                        data=payload, headers={"Content-Type": "application/json"}, method="POST"
                    )
                    urllib.request.urlopen(req, timeout=5)
                except Exception:
                    pass
                failed.append(slug)
                continue
            passes = review_result.get("overall_pass", True)
            fixes = review_result.get("issues_fixed", 0)
            log(f"  [review] {'✅ PASS' if passes else '⚠️ fixed'} | "
                f"rounds={review_result.get('rounds',0)} | auto_fixes={fixes}")

        # 2. Parse frontmatter + validate for internal notes (TASK A)
        try:
            raw = draft_path.read_text("utf-8")
            meta, body_md = parse_frontmatter(raw)
        except Exception as e:
            log(f"  ERROR: Could not parse draft: {e}")
            failed.append(slug)
            continue

        # 2a. TASK A: Validate draft for internal metadata
        is_clean, error_msg = validate_draft_for_internal_notes(slug, raw)
        if not is_clean:
            log(f"  BLOCKED: {error_msg}")
            # Set status to draft_error
            if not args.dry_run:
                set_status(pipeline, slug, "draft_error")
                # Notify AIena
                notify_aiena_internal(
                    f"ERRORE BOZZA BLOCCATA: [{slug}]\n"
                    f"{error_msg}\n"
                    f"Rimuovi i metadati interni e risalva il draft."
                )
            failed.append(slug)
            continue

        # 2b. Convert markdown
        try:
            body_html = md_to_html(body_md)
        except Exception as e:
            log(f"  ERROR: Could not convert draft: {e}")
            failed.append(slug)
            continue

        # 3. Build preview HTML
        try:
            preview_html = build_preview_html(slug, meta, body_html)
        except Exception as e:
            log(f"  ERROR: Could not build preview HTML: {e}")
            failed.append(slug)
            continue

        # 4. Write local file (primary — nginx serves /var/www/aiena.it/preview/ locally)
        local_preview = PREVIEW_LOCAL / f"{slug}.html"
        try:
            if not args.dry_run:
                local_preview.write_text(preview_html, "utf-8")
            log(f"  Local file written: {local_preview}")
        except Exception as e:
            log(f"  ERROR: Could not write local file: {e}")
            failed.append(slug)
            continue

        # 5. FTP upload (secondary — remote mirror at ftp.aiena.it)
        ftp_ok = ftp_upload(local_preview, f"preview/{slug}.html", dry_run=args.dry_run)
        if not ftp_ok:
            # FIX Bug#2: track FTP failures explicitly; local file IS accessible to
            # nginx and auto_publish (reads /var/www/aiena.it/preview/), so pipeline
            # update proceeds but we flag the FTP gap for notification.
            log(f"  ⚠️  FTP FAILED for {slug} — local preview OK, remote mirror may lag")
            ftp_failed.append(slug)

        # 6. Update pipeline.json status (only if local write succeeded, which it did)
        if not args.dry_run:
            set_status(pipeline, slug, "preview")

        processed.append(slug)

    # 7. Save updated pipeline.json
    if processed and not args.dry_run:
        save_pipeline(pipeline)
        log(f"\nPipeline saved: {len(processed)} slug(s) → 'preview'")

    # 8. Rebuild admin data.json
    if processed:
        rebuild_admin(dry_run=args.dry_run)

    # 9. Notify AIena
    if processed and not args.dry_run:
        notify_aiena(processed)

    # 10. Notify Mirko
    if processed and not args.dry_run:
        notify_mirko(processed)

    log(f"\nDONE: {len(processed)} processed, {len(failed)} failed")
    if failed:
        log(f"Failed: {failed}")
    if ftp_failed:
        log(f"FTP upload failures (local OK): {ftp_failed}")
    log("aiena_preview_cron.py END\n")


if __name__ == "__main__":
    main()
