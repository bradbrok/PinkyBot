{
  "site_root": "/var/www/bitcoinmarket.net",
  "output_dir": "/home/pinky/.pinkybot/scripts/reports",
  "html_extensions": [
    ".html",
    ".htm"
  ],
  "exclude_dirs": [
    "assets",
    "css",
    "js",
    "images",
    "img",
    "fonts",
    "logos",
    "scripts",
    ".git",
    "logs",
    "preview",
    "bewertungen",
    "templates",
    "tools"
  ],
  "exclude_files": [
    "*-DRAFT.html",
    "*-BACKUP.html",
    "*-OLD.html",
    "preview-*.html",
    "sponsored-demo.html"
  ],
  "page_types": {
    "review": {
      "path_patterns": [
        "reviews/",
        "/reviews/"
      ],
      "require_schema": true,
      "schema_types": [
        "Review",
        "Product"
      ],
      "require_cta": true,
      "require_last_updated": true
    },
    "guide": {
      "path_patterns": [
        "guide/",
        "/guide/"
      ],
      "require_schema": true,
      "schema_types": [
        "HowTo",
        "Article",
        "FAQPage"
      ],
      "require_cta": false,
      "require_last_updated": true
    },
    "magazine": {
      "path_patterns": [
        "magazine/",
        "/magazine/"
      ],
      "require_schema": true,
      "schema_types": [
        "Article",
        "NewsArticle"
      ],
      "require_cta": false,
      "require_last_updated": true
    },
    "landing": {
      "path_patterns": [
        "index.html",
        "/index.html"
      ],
      "require_schema": true,
      "schema_types": [
        "Organization",
        "WebSite"
      ],
      "require_cta": true,
      "require_last_updated": false
    },
    "static": {
      "path_patterns": [
        "/privacy",
        "/disclaimer",
        "/affiliate-disclosure",
        "/faq",
        "/glossario"
      ],
      "require_schema": false,
      "require_cta": false,
      "require_last_updated": false
    }
  },
  "seo_limits": {
    "title_max_chars": 60,
    "description_max_chars": 160,
    "description_min_chars": 50
  },
  "link_check": {
    "enabled": true,
    "timeout_seconds": 8,
    "max_concurrent": 5,
    "skip_protocols": [
      "mailto:",
      "tel:",
      "javascript:"
    ],
    "skip_domains": [
      "coinbase.com",
      "crypto.com",
      "bybit.com",
      "kraken.com",
      "invite.kraken.com",
      "partner.bybit.com",
      "binance.com",
      "kucoin.com",
      "okx.com",
      "bitget.com",
      "bingx.com",
      "etoro.com",
      "bitvavo.com",
      "nexo.io",
      "bitpanda.com",
      "twitter.com",
      "x.com",
      "facebook.com",
      "instagram.com",
      "linkedin.com",
      "t.me",
      "apple.com",
      "google.com"
    ]
  },
  "journalist_roster": [
    "Marco Lamport",
    "Sara Kova\u010d",
    "Thomas Voss",
    "Luca Finney",
    "Sara Novak",
    "Elena Szabo",
    "Giulia Turing",
    "Segugio",
    "Segugio / BitcoinMarket Research"
  ],
  "italian_bleed": {
    "lang_suffixes": [
      "-en.html",
      "-es.html",
      "-de.html"
    ],
    "lang_path_patterns": [
      "/en/",
      "/es/",
      "/de/"
    ],
    "forbidden_patterns": [
      "\\bOAM\\b",
      "Quadro\\s+RW",
      "regime\\s+dichiarativo",
      "Agenzia\\s+delle\\s+Entrate",
      "per\\s+gli\\s+utenti\\s+italiani",
      "per\\s+i\\s+trader\\s+italiani",
      "modulo\\s+730",
      "730\\s+precompilato",
      "\\bIVAFE\\b",
      "imposta\\s+di\\s+bollo\\s+cripto"
    ],
    "whitelist_pages": [
      "bitget-mica-casp-deadline-2026-en.html",
      "bitget-mica-casp-deadline-2026-de.html",
      "bitget-mica-casp-deadline-2026-es.html",
      "crypto-tax-italy-2026-en.html",
      "mica-casp-deadline-country-by-country-2026-en.html",
      "mica-casp-fecha-limite-pais-por-pais-2026-es.html",
      "mica-casp-frist-land-fur-land-2026-de.html"
    ]
  },
  "lang_convention": {
    "_comment": "bitcoinmarket.net: no-suffix pages ARE Italian base pages (lang=it). EN/DE/ES variants use -en/-de/-es suffixes.",
    "default_lang": "it",
    "suffix_to_lang": {
      "-en.html": "en",
      "-de.html": "de",
      "-es.html": "es"
    }
  },
  "sitemap_path": "/var/www/bitcoinmarket.net/sitemap.xml",
  "dynamic_nosnippet": {
    "section_patterns": [
      "btc-news",
      "news-section",
      "price-ticker",
      "live-price"
    ]
  },
  "canonical_whitelist": [
    "index.html"
  ]
}