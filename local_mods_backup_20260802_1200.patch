+                maxBytes=10 * 1024 * 1024,
+                backupCount=3,
+            )
             _log_fh.setLevel(logging.DEBUG)
             _log_fh.setFormatter(logging.Formatter("%(asctime)s %(levelname)s %(message)s"))
             log.addHandler(_log_fh)
